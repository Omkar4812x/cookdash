datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      String   @default("customer") // "customer", "cook", "admin"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cookProfile CookProfile?
  bookings    Booking[]
  reviews     Review[]
}

model CookProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug         String   @unique
  tagline      String
  bio          String   @db.Text
  cuisines     String // Comma separated or JSON string
  dietary      String // Comma separated or JSON string
  rating       Float    @default(4.9)
  reviewsCount Int      @default(0)
  price        Float
  distance     Float
  avatar       String
  gradient     String
  specialties  String // Comma separated or JSON string
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  menus    Menu[]
  bookings Booking[]
  reviews  Review[]
}

model Menu {
  id            String      @id @default(uuid())
  cookProfileId String
  cookProfile   CookProfile @relation(fields: [cookProfileId], references: [id], onDelete: Cascade)
  name          String
  price         Float
  description   String      @db.Text
  dishes        String // JSON string representing array of {name, desc}
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Booking {
  id                  String      @id @default(uuid())
  customerId          String
  customer            User        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  cookProfileId       String
  cookProfile         CookProfile @relation(fields: [cookProfileId], references: [id], onDelete: Cascade)
  menuId              String
  menuName            String
  date                String
  time                String
  guests              Int
  specialInstructions String?     @db.Text
  total               Float
  status              String      @default("Pending Approval") // "Confirmed", "Pending Approval", "Completed", "Cancelled"
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  review Review?
}

model Review {
  id            String      @id @default(uuid())
  bookingId     String      @unique
  booking       Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId    String
  customer      User        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  cookProfileId String
  cookProfile   CookProfile @relation(fields: [cookProfileId], references: [id], onDelete: Cascade)
  rating        Float
  text          String      @db.Text
  date          String
  createdAt     DateTime    @default(now())
}
